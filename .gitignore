# 依賴（只有截圖 / 圖示產生腳本需要；執行 App 本身不需要任何依賴）
node_modules/
package-lock.json

# 暫存 / 系統
*.tmp
*.log
# 整套測試的完整 log（共用慣例 v6 §5.7：寫在 repo 底下、被擋掉的目錄，不寫系統暫存目錄）
.logs/
Thumbs.db
.DS_Store
desktop.ini

# 冒煙測試產生的截圖（QA 用，可由 npm run screenshots 重產）
screenshots/_smoke/
screenshots/_*.png
scripts/_*.mjs
screenshots/_layout/
screenshots/_layout-report.txt
screenshots/_v147/
screenshots/_recapcard/
# 鏈上測試的截圖輸出（只產生、不比對；run-affected 的工作區守衛不准測試寫進版控的檔）
screenshots/_out/

# 本機開發設定（不影響部署）
.claude/settings.local.json

# 推送前自查的「家人與真實行程」名單（v1.91；scripts/prepush-scan.mjs 讀它，名單本身絕不進 repo——怎麼建見 docs/STATUS.md）
.private/

# 生圖素材的收件資料夾（2026-11-16；Yolin 從 ChatGPT 下載的原圖丟這裡，切圖、去背的中間產物也在這裡；
# 確認要用的才複製進 media/art/ 進版控——流程見 docs/ART_生圖素材.md）
art-inbox/

# Puppeteer 本地下載的瀏覽器（若下載到專案內）
.pptr-cache/

# 自架伺服器的資料
server/data/

# Cloudflare Wrangler 本機狀態 / 機密
.wrangler/
.dev.vars
workers/.wrangler/

# 地點資料建置腳本的原始擷取（可重新產生）
data/_raw/
data/places/_staging/
