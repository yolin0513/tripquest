# 依賴（只有截圖 / 圖示產生腳本需要；執行 App 本身不需要任何依賴）
node_modules/
package-lock.json

# 暫存 / 系統
*.tmp
*.log
Thumbs.db
.DS_Store
desktop.ini

# 冒煙測試產生的截圖（QA 用，可由 npm run screenshots 重產）
screenshots/_smoke/
screenshots/_*.png
scripts/_*.mjs

# 本機開發設定（不影響部署）
.claude/settings.local.json

# Puppeteer 本地下載的瀏覽器（若下載到專案內）
.pptr-cache/

# 自架伺服器的資料
server/data/

# Cloudflare Wrangler 本機狀態 / 機密
.wrangler/
.dev.vars
workers/.wrangler/
